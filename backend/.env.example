# ============================================
# VAJRANOWCAST — ENVIRONMENT CONFIGURATION TEMPLATE
# Copy to .env and fill in your project credentials
# ============================================

# --- Supabase Project Credentials ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOi...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...
SUPABASE_JWT_SECRET=your_jwt_secret_here

# --- Machine Admin Authentication Token ---
ADMIN_TOKEN=your_secure_random_admin_token_for_github_actions

# --- Server Configurations ---
API_HOST=0.0.0.0
API_PORT=8000
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://vajranowcast.vercel.app

# --- Data Sources ---
OPEN_METEO_URL=https://api.open-meteo.com/v1/forecast
OPEN_METEO_ARCHIVE_URL=https://archive-api.open-meteo.com/v1/archive
GFS_NOMADS_URL=https://nomads.ncep.noaa.gov/cgi-bin/filter_gfs_0p25.pl
GITHUB_PAGES_BASE_URL=https://uday-mahajan-dev.github.io/vajranowcast
RENDER_BACKEND_URL=https://vajranowcast-api.onrender.com


# --- Geographic Boundaries (India) ---
INDIA_LAT_MIN=6.0
INDIA_LAT_MAX=38.0
INDIA_LON_MIN=68.0
INDIA_LON_MAX=98.0

# --- ML Model & Storage ---
MODEL_DIR=./app/ml/saved_models
CACHE_TTL_MINUTES=15

# --- Prediction & Alert Thresholds ---
ALERT_PROB_THRESHOLD=0.6
SEVERE_PROB_THRESHOLD=0.75
OPTIMAL_THRESHOLD=0.1860

# --- Rate Limiting (slowapi) ---
RATE_LIMIT_NOWCAST=60/hour
RATE_LIMIT_CITIES=30/hour
RATE_LIMIT_ALERTS=10/hour
